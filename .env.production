# ============================================
# 南邮知识库 — 生产环境变量模板
# 复制此文件为 .env 并修改配置
#   cp .env.production .env
# ============================================

# 域名 (如 https://kb.njupt.edu.cn 或 http://your-server-ip)
DOMAIN=http://localhost

# 前端 API 地址 (Nginx 反向代理时留空 = 同源)
NEXT_PUBLIC_API_URL=

# PostgreSQL
DB_USER=njupt
DB_PASSWORD=请修改为强密码
DB_NAME=njupt_kb

# JWT 密钥 (生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=请修改为随机长字符串

# CORS (JSON 数组格式)
CORS_ORIGINS=["http://localhost","https://你的域名"]

# Redis
REDIS_URL=redis://redis:6379/0
