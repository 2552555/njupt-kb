# ============================================
# 生产环境变量模板：cp .env.production .env
# 与 docker-compose.prod.yml 配套使用
# 缺失必需项时后端拒绝启动（设计文档 §31.1）
# ============================================

ENV=prod
PUBLIC_BASE_URL=https://kb.example.com

# --- 会话密钥（必需，且不能是示例值）---
# 生成: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- PostgreSQL ---
DB_USER=njupt
DB_PASSWORD=
DB_NAME=njupt_kb

# --- CORS：必须是 JSON 数组，禁止通配符 ---
CORS_ORIGINS=["https://kb.example.com"]

# --- 对象存储：建议使用托管 S3 兼容服务 ---
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_QUARANTINE=njupt-quarantine
S3_BUCKET_PRIVATE=njupt-private
S3_FORCE_PATH_STYLE=false

# --- 内容安全检查：生产不允许 disabled ---
SCANNER=clamav
CLAMD_HOST=clamav
CLAMD_PORT=3310

# --- 邮件（必需，用于邮箱验证与找回密码）---
MAIL_ENABLED=true
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- 阶段开关：未确认商业模式与模型外发授权前保持 false ---
COMMERCE_ENABLED=false
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
