# ============================================
# 开发环境变量模板：cp .env.example .env
# 生产环境见 .env.production
# ============================================

ENV=dev
PUBLIC_BASE_URL=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_USER=njupt
POSTGRES_PASSWORD=njupt
POSTGRES_DB=njupt_kb

# --- 会话密钥：开发留空则每次启动随机生成；生产必须显式配置 ---
# 生成: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- 对象存储（开发为 compose 内的 MinIO）---
MINIO_ROOT_USER=njupt
MINIO_ROOT_PASSWORD=njupt-dev-secret
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=njupt
S3_SECRET_ACCESS_KEY=njupt-dev-secret
S3_BUCKET_QUARANTINE=njupt-quarantine
S3_BUCKET_PRIVATE=njupt-private
S3_FORCE_PATH_STYLE=true

# --- 内容安全检查 ---
# clamav: 需要 docker compose --profile scan up -d；disabled 时文件停留在隔离区，不可发布
SCANNER=clamav
CLAMD_HOST=clamav
CLAMD_PORT=3310

# --- 邮件：开发关闭，验证与找回密码令牌会写入结构化日志 ---
MAIL_ENABLED=false
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- 阶段开关（§6）：关闭时相关接口返回 FEATURE_NOT_ENABLED，不做假成功 ---
COMMERCE_ENABLED=false
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
