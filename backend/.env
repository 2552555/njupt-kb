# ============================================
# 南邮知识库 — 后端环境变量
# ============================================

# 数据库 (开发: SQLite, 生产: PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./njupt_kb.db
# 生产示例:
# DATABASE_URL=postgresql+asyncpg://njupt_user:strong_password@db:5432/njupt_kb

# JWT 密钥 (生产环境务必改为随机长字符串!)
SECRET_KEY=njupt-kb-dev-secret-change-in-production

# 文件上传目录
UPLOAD_DIR=uploads

# 单文件最大上传大小 (50MB)
MAX_UPLOAD_SIZE=52428800

# CORS 允许的跨域来源 (逗号分隔)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Redis 缓存 (可选, 生产环境推荐启用)
# REDIS_URL=redis://localhost:6379/0

# AI API 密钥 (可选)
# DEEPSEEK_API_KEY=sk-xxx
# OPENAI_API_KEY=sk-xxx
